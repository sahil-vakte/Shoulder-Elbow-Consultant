# Public site URL (no trailing slash) — used for canonical URLs, sitemap and schema
NEXT_PUBLIC_SITE_URL=https://shoulderelbowconsultant.co.uk

# Google Analytics 4 measurement ID (loaded only after cookie consent)
NEXT_PUBLIC_GA_ID=

# Enquiry form delivery (optional). If RESEND_API_KEY is set, enquiries are emailed via Resend.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=info@shoulderelbowconsultant.co.uk
ENQUIRY_FROM_EMAIL=website@shoulderelbowconsultant.co.uk

# Optional: forward enquiries to your booking app / CRM as JSON (e.g. the Django booking API)
ENQUIRY_WEBHOOK_URL=
